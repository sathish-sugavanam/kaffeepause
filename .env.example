# Signing secret from Linear: Settings → API → Webhooks → your webhook.
LINEAR_WEBHOOK_SECRET=

# The harness's own database (see "Agents" in README.md to create it).
# Use host `db` inside Compose, `localhost` outside it. URL-encode special characters in the password.
DATABASE_URL=postgresql://agents:CHANGE_ME@db:5432/agents

# Celery broker for the worker and beat. Use host `redis` inside Compose, `localhost` outside it.
REDIS_URL=redis://redis:6379/0

# Fine-grained GitHub token for this repository only: Contents and Pull requests, read and write.
# Only the worker uses it; run containers never receive it.
GITHUB_TOKEN=
# The repository the agents open pull requests against, as owner/name.
GITHUB_REPO=owner/repo

# Credential for the agents, passed into each run container. Use one of:
# - Anthropic directly: an API key from console.anthropic.com, with a monthly spend limit.
ANTHROPIC_API_KEY=
# - OpenRouter: leave ANTHROPIC_API_KEY empty and set these. Put a credit limit on the key,
#   because the agent's per-run budget cap can't price non-Claude models.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# Model per agent. Defaults: tester and security claude-sonnet-5-5, coder claude-opus-5-5.
# With OpenRouter, use its model IDs.
# TESTER_MODEL=
# CODER_MODEL=
# SECURITY_MODEL=
# Budget for one run across all agents, in USD.
# RUN_BUDGET_USD=10

# Optional readiness gate: Jev (docs.typesafe.ai) judges each issue before any agent runs,
# and refuses untestable or oversized ones with ISSUE_NOT_READY. Off when the key is empty.
# Only the worker uses it; run containers never receive it.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
